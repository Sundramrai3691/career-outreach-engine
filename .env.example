# ====================================================================
# Referral Engine - Environment Configuration Template
# ====================================================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (Default: SQLite local zero-config database)
DATABASE_URL="file:./dev.db"

# AES-256 Secret Key (Used for encrypting API keys and Google tokens at rest)
# Generate a strong 32-byte hexadecimal string or random key
ENCRYPTION_SECRET=e7b4e3c1a2f698d04217bc5823190dfa83c74125b6a9810432c7e1903fa654db

# Google Cloud OAuth 2.0 Credentials
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Ensure redirect URI matches exactly: http://localhost:5000/api/google/oauth2callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth2callback

# Contact Discovery Provider Credentials (Optional: can also be saved via UI Settings)
TOMBA_API_KEY=
TOMBA_SECRET_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Outreach Safety Settings
# Conservative application daily sending cap for personal outreach (default: 30)
DAILY_GMAIL_SEND_CAP=30
